# Which model provider classifies videos: nvidia (default) or gemini
BRAINROT_BACKEND=nvidia
# NVIDIA API catalog key: https://build.nvidia.com (model must accept images)
NVIDIA_API_KEY=your-nvidia-key-here
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
# Get a key at https://aistudio.google.com/apikey (used when BRAINROT_BACKEND=gemini)
GEMINI_API_KEY=your-key-here
# Any Gemini model that accepts video input
GEMINI_MODEL=gemini-3.8-flash
# native (whole video) | frames (keyframes + audio). NVIDIA always uses frames, without audio.
BRAINROT_MODE=native
BRAINROT_THRESHOLD=50
BRAINROT_NATIVE_FPS=2
BRAINROT_MAX_FRAMES=16
BRAINROT_MAX_SECONDS=180
