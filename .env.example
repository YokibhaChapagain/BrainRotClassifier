# Model provider that classifies videos
BRAINROT_BACKEND=gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Any Gemini model that accepts video input
GEMINI_MODEL=gemini-3.8-flash
# native (whole video) | frames (keyframes + audio)
BRAINROT_MODE=native
BRAINROT_THRESHOLD=50
BRAINROT_NATIVE_FPS=2
BRAINROT_MAX_FRAMES=16
BRAINROT_MAX_SECONDS=180
