{
  "manifest_version": 3,
  "name": "BrainRot Meter",
  "version": "0.1.0",
  "description": "Live brain rot meter for TikTok and Instagram Reels.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*", "https://www.instagram.com/*"],
      "js": ["config.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "BrainRot Meter" }
}
